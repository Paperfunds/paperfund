# Copy to .env.production and replace every example value before launch. Never commit that file.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_ORIGIN=https://api.paperfund.app
APP_PUBLIC_ORIGIN=https://app.paperfund.app
DATABASE_URL=postgresql://paperfund:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/paperfund
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379
SOLANA_RPC_URL=https://REPLACE_WITH_PRIVATE_RPC_ENDPOINT
SOLANA_RPC_TIMEOUT_MS=10000
SOLANA_COMMITMENT=confirmed
LOG_LEVEL=info
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=86400
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=https://app.paperfund.app,chrome-extension://lcnpjpkojoadojibfbjfohpjepkfmdln
VITE_API_BASE_URL=https://api.paperfund.app
PAPERFUND_REQUIRE_PRODUCTION_ORIGINS=true
PAPERFUND_API_BASE_URL=https://api.paperfund.app
PAPERFUND_APP_URL=https://app.paperfund.app
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_AUTH_MAX=20
API_RATE_LIMIT_TRADE_MAX=30
WORKER_TICK_INTERVAL_MS=5000
WORKER_HEARTBEAT_FILE=logs/worker-heartbeat.json
REWARD_ALLOCATION_MODE=NORMAL
REWARD_BASELINE_WINDOW=12
REWARD_LAMBDA_BPS=6000
REWARD_FINALIZATION_GRACE_SECONDS=60

# Keep shadow mode on until identity verification and mainnet backfill acceptance are complete.
CREATOR_FEE_INGESTION_ENABLED=false
CREATOR_FEE_SHADOW_MODE=true
CREATOR_FEE_NETWORK=mainnet-beta
PAPERFUND_TOKEN_MINT=
PAPERFUND_CREATOR_WALLET=
CREATOR_FEE_PAGE_SIZE=50
CREATOR_FEE_RPC_MAX_ATTEMPTS=4
CREATOR_FEE_RPC_MIN_INTERVAL_MS=75

# Keep execution disabled until the treasury, signer, approval flow, and cap are reviewed.
PAYOUT_EXECUTION_ENABLED=false
PAYOUT_NETWORK=mainnet-beta
PAYOUT_MAINNET_CONFIRM=false
PAYOUT_TREASURY_PUBLIC_KEY=
PAYOUT_SIGNER_TYPE=DISABLED
PAYOUT_SIGNER_SECRET_KEY=
PAYOUT_MAX_RECIPIENTS_PER_BATCH=8
PAYOUT_MAINNET_MAX_PLAN_LAMPORTS=100000000

# Used by compose.production.yml; generate independent random values.
PAPERFUND_POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
PAPERFUND_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
