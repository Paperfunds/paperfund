{
  "name": "paperfund",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "tsc -b && npm run build --workspace @paperfund/web",
    "build:extension": "npm run build --workspace @paperfund/extension",
    "package:extension": "node scripts/package-extension.mjs",
    "validate:extension:store": "node scripts/validate-extension-release.mjs",
    "test:extension:headed": "npm run build:extension && playwright test --config playwright.extension.config.ts --grep-invert @live",
    "test:extension:live": "npm run build:extension && playwright test --config playwright.extension.config.ts --grep @live",
    "dev:extension": "npm run dev --workspace @paperfund/extension",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:extension": "npm run test --workspace @paperfund/extension",
    "test:e2e": "npm run build && playwright test",
    "e2e:server": "tsx apps/api/test/e2e-server.ts",
    "db:generate": "npm run db:generate --workspace @paperfund/db",
    "db:migrate": "npm run build && npm run db:migrate --workspace @paperfund/db",
    "db:check": "npm run build && npm run db:check --workspace @paperfund/db",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-backup.ps1",
    "db:restore-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-restore-smoke.ps1",
    "start:api": "npm run start --workspace @paperfund/api",
    "start:worker": "npm run start --workspace @paperfund/worker",
    "ops:check": "tsx scripts/ops-check.ts",
    "payout:approve": "tsx scripts/payout-approve.ts",
    "settlement:round": "tsx scripts/settlement-round.ts",
    "payout:execute": "tsx scripts/payout-execute.ts",
    "payout:status": "tsx scripts/payout-status.ts",
    "payout:reconcile": "tsx scripts/payout-status.ts --reconcile",
    "payout:devnet-smoke-seed": "tsx scripts/devnet-payout-smoke-seed.ts",
    "creator-fees:backfill": "tsx scripts/creator-fees-backfill.ts",
    "creator-fees:status": "tsx scripts/creator-fees-status.ts",
    "test:publication": "vitest run packages/core/test apps/api/isolated/current-quotes/router.test.ts apps/api/isolated/current-quotes/cutoff.test.ts packages/protocols/test/secret-diagnostics.test.ts scripts/browser-config-security.test.ts scripts/extension-script-validation.test.ts && node --test apps/api/isolated/current-quotes/production-public/policy.test.mjs apps/api/isolated/current-quotes/production-public/discovery.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "7.3.6",
    "vitest": "^5.0.1"
  },
  "license": "Apache-2.0"
}
