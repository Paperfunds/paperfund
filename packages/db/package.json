{
  "name": "@paperfund/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./private/payout-security": {
      "types": "./dist/payout-security.d.ts",
      "default": "./dist/payout-security.js"
    },
    "./private/payout-treasury": {
      "types": "./dist/payout-treasury.d.ts",
      "default": "./dist/payout-treasury.js"
    },
    "./private/payout-approval": {
      "types": "./dist/payout-approval.d.ts",
      "default": "./dist/payout-approval.js"
    },
    "./private/legacy-settlement": {
      "types": "./dist/legacy-settlement.d.ts",
      "default": "./dist/legacy-settlement.js"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:check": "tsx src/check.ts"
  },
  "dependencies": {
    "@paperfund/config": "*",
    "@paperfund/core": "*",
    "@paperfund/execution": "*",
    "@paperfund/protocols": "*",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  },
  "license": "Apache-2.0"
}
